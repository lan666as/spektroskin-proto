# Copy to .env and fill with fresh random values: openssl rand -base64 32
# Infrastructure secrets only. Demo user passwords live hashed in the database
# and are created with the create_user CLI (see PLAN.md, "Credentials").
POSTGRES_PASSWORD=
JWT_SECRET=

# One-tap demo sign-in on the login screen (no password). Set to false to require passwords.
DEMO_LOGIN=true
